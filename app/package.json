{
  "name": "gear-miles-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Device-hosted dashboard for gear-miles (local-first, no CDN, no analytics)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:contract": "node --experimental-strip-types --test tests/contract/",
    "test:a11y": "node tests/a11y/smoke.mjs",
    "audit:assets": "node scripts/audit_assets.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "~5.6.0",
    "vite": "~5.4.0"
  }
}
